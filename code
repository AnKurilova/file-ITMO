with open("CdSe_CdZnS Core_Shell.txt") as f:
    values = [float(s.split('\t')[1].strip().replace(',', '.')) for s in f.readlines()]
    mean_value = sum(values) / len(values)
    standart_deviation = 0
    for x in values:
        standart_deviation += (x - mean_value) ** 2
    standart_deviation /= len(values)
    standart_deviation = standart_deviation ** 0.5

    print(f"Mean value: {mean_value}\nStandart deviation: {standart_deviation}")
